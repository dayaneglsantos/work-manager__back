// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ==================================================== ENUMS ====================================================
enum EmploymentStatus {
  active // Usuário ativo
  inactive // Usuário inativo
  terminated // Usuário demitido
  resigned // Usuário pediu demissão
}

enum PasswordRequestPurpose {
  passwordReset
  passwordCreation
}

enum TaskStatus {
  todo // A fazer
  inProgress // Em progresso
  done // Concluído
  paused // Pausado
}

enum TaskPriority {
  low // Baixa prioridade
  medium // Média prioridade
  high // Alta prioridade
}

enum CommentType {
  task // Comentário em tarefa
  post // Comentário em post
}

// ==================================================== MODELS ====================================================

model Profile {
  id          Int                 @id @default(autoincrement())
  name        String              @unique
  fullAccess  Boolean             @default(false) @map("full_access")
  users       User[]
  permissions ProfilePermission[] // Relaciona com a tabela de permissões de perfil

  @@map("profiles")
}

model Department {
  id        Int    @id @default(autoincrement())
  name      String @unique
  managerId Int    @map("manager_id")
  manager   User   @relation("UserManager", fields: [managerId], references: [id])
  users     User[] @relation("UserDepartment") // Faz a relação com os usuários do departamento
  tasks     Task[] // Tarefas relacionadas ao departamento

  @@map("departments") // Mapeia o nome da tabela para "departments"
}

model User {
  id                 Int              @id @default(autoincrement())
  name               String
  email              String           @unique
  cpf                String           @unique @db.Char(11)
  phoneNumber        String?          @map("phone_number")
  address            Address?
  birthDate          DateTime?        @db.Date @map("birth_date")
  password           String?
  profileImage         String?          @map("profile_image")
  profileImagePublicId String?          @map("profile_image_public_id")
  managedDepartament Department[]     @relation("UserManager") // Faz a relação com o departamento que o usuário gerencia
  profileId          Int              @map("profile_id")
  profile            Profile          @relation(fields: [profileId], references: [id])
  departmentId       Int?             @map("department_id")
  department         Department?      @relation("UserDepartment", fields: [departmentId], references: [id])
  currentSalary      Float            @map("current_salary")
  admissionDate      DateTime         @db.Date @map("admission_date")
  currentPosition    String           @map("current_position")
  employmentStatus   EmploymentStatus @default(active) @map("employment_status")
  statusReason       String?          @map("status_reason")
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")
  notes              String?

  // Relacionamentos
  customPermissions   CustomPermission[] // Relaciona com a tabela de permissões personalizadas
  tasksAssigned       Task[]             @relation("TaskAssignee") // Tarefas atribuídas ao usuário
  tasksCreated        Task[]             @relation("TaskCreator") // Tarefas criadas pelo usuário
  changedTasks        TaskHistory[] // Histórico de mudanças de tarefas
  comments            Comment[] // Comentários feitos pelo usuário
  commentMentions     CommentMention[] // Comentários em que o usuário foi mencionado
  passwordResetTokens PasswordReset[]
  systemOwnership     SystemOwner?

  @@map("users") // Mapeia o nome da tabela para "users"
}

model SystemOwner {
  id        Int      @id @default(1)
  userId    Int      @unique @map("user_id")
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("system_owner")
}

model Address {
  id         Int     @id @default(autoincrement())
  zipCode    String  @map("zip_code")
  state      String
  city       String
  street     String
  number     Int
  complement String?
  userId     Int     @unique @map("user_id")
  user       User    @relation(fields: [userId], references: [id])

  @@map("addresses") // Mapeia o nome da tabela para "addresses"
}

model PermissionAction {
  id          Int          @id @default(autoincrement())
  name        String       @unique
  permissions Permission[]

  @@map("permission_actions") // Mapeia o nome da tabela para "permission_actions"
}

model PermissionType {
  id          Int          @id @default(autoincrement())
  name        String       @unique
  permissions Permission[]

  @@map("permission_types") // Mapeia o nome da tabela para "permission_types"
}

model Permission {
  id                Int                 @id @default(autoincrement())
  name              String              @unique
  actionId          Int                 @map("action_id")
  action            PermissionAction    @relation(fields: [actionId], references: [id])
  typeId            Int                 @map("type_id")
  type              PermissionType      @relation(fields: [typeId], references: [id])
  permissions       ProfilePermission[] // Relaciona com a tabela de permissões de perfil
  customPermissions CustomPermission[] // Relaciona com a tabela de permissões personalizadas

  @@map("permissions") // Mapeia o nome da tabela para "permissions"
}

model ProfilePermission {
  id            Int        @id @default(autoincrement())
  profileId     Int        @map("profile_id")
  profile       Profile    @relation(fields: [profileId], references: [id])
  permissionId  Int        @map("permission_id")
  permission    Permission @relation(fields: [permissionId], references: [id])
  hasPermission Boolean    @default(false) @map("has_permission")

  @@unique([profileId, permissionId])
  @@map("profile_permissions") // Mapeia o nome da tabela para "profile_permissions"
}

model CustomPermission {
  id            Int        @id @default(autoincrement())
  userId        Int        @map("user_id")
  user          User       @relation(fields: [userId], references: [id])
  permissionId  Int        @map("permission_id")
  permission    Permission @relation(fields: [permissionId], references: [id])
  hasPermission Boolean    @default(false) @map("has_permission")

  @@unique([userId, permissionId])
  @@map("custom_permissions") // Mapeia o nome da tabela para "custom_permissions"
}

model Tag {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  tasks     TaskTag[] // Relaciona com as tarefas que possuem essa tag
  createdAt DateTime  @default(now()) @map("created_at")
}

model Task {
  id           Int           @id @default(autoincrement())
  title        String
  description  String?       @db.Text
  status       TaskStatus    @default(todo)
  deadline     DateTime? @db.Date
  assigneeId   Int?          @map("assignee_id")
  creatorId    Int           @map("creator_id")
  departmentId Int?          @map("department_id")
  assignee     User?         @relation("TaskAssignee", fields: [assigneeId], references: [id])
  creator      User          @relation("TaskCreator", fields: [creatorId], references: [id])
  department   Department?   @relation(fields: [departmentId], references: [id])
  priority     TaskPriority  @default(medium)
  history      TaskHistory[]
  tags         TaskTag[] // Relaciona com as tags da tarefa
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  blockedBy    Int?   @map("blocked_by") // Coluna com o id da tarefa que bloqueia esta tarefa
  blocking     Task?  @relation("TaskBlocking", fields: [blockedBy], references: [id]) // Tarefa que bloqueia esta tarefa
  blockedTasks Task[] @relation("TaskBlocking") // Tarefas que esta tarefa bloqueia

  parentTaskId Int?      @map("parent_task_id") // Coluna com o id da tarefa pai
  parentTask   Task?     @relation("TaskSubtasks", fields: [parentTaskId], references: [id]) // Tarefa pai
  subtasks     Task[]    @relation("TaskSubtasks") // Subtarefas desta tarefa
  comments     Comment[]

  @@map("tasks")
}

model TaskTag {
  id     Int  @id @default(autoincrement())
  taskId Int  @map("task_id")
  task   Task @relation(fields: [taskId], references: [id])
  tagId  Int  @map("tag_id")
  tag    Tag  @relation(fields: [tagId], references: [id])

  @@unique([taskId, tagId]) // Garante que uma tarefa não tenha a mesma tag mais de uma vez
  @@map("tasks_tags") // Mapeia o nome da tabela para "tasks_tags"
}

model TaskHistory {
  id          Int      @id @default(autoincrement())
  taskId      Int      @map("task_id")
  task        Task     @relation(fields: [taskId], references: [id])
  field       String
  oldValue    String?  @map("old_value")
  newValue    String?  @map("new_value")
  changedById Int      @map("changed_by_id")
  changedBy   User     @relation(fields: [changedById], references: [id])
  changedAt   DateTime @default(now()) @map("changed_at")

  @@map("tasks_history")
}

model Comment {
  id       Int    @id @default(autoincrement())
  content  String @db.Text
  authorId Int    @map("author_id")
  author   User   @relation(fields: [authorId], references: [id])

  taskId Int?  @map("task_id") // ID da tarefa, se o comentário for sobre uma tarefa
  task   Task? @relation(fields: [taskId], references: [id])

  // Fazer relações para posts e outros tipos de comentários futuramente

  parentCommentId Int?      @map("parent_comment_id") // ID do comentário pai, se for uma resposta
  parentComment   Comment?  @relation("CommentReply", fields: [parentCommentId], references: [id])
  reply           Comment[] @relation("CommentReply") // Respostas a comentários
  edited          Boolean   @default(false)

  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  commentMentions CommentMention[]

  @@index([parentCommentId]) // Índice para facilitar buscas por comentários pai
  @@map("comments")
}

model CommentMention {
  id Int @id @default(autoincrement())

  commentId Int     @map("comment_id")
  comment   Comment @relation(fields: [commentId], references: [id], onDelete: Cascade) // Ao excluir o comentário, excluir as menções relacionadas

  userId Int  @map("user_id")
  user   User @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([commentId, userId])
  @@map("comment_mentions")
}

model PasswordReset {
  id     Int  @id @default(autoincrement())
  userId Int  @map("user_id")
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade) // Ao excluir o usuário, excluir os tokens de redefinição de senha relacionados

  purpose PasswordRequestPurpose @default(passwordReset)

  codeHash      String    @map("code_hash") // Hash do código de verificação enviado por e-mail
  codeExpiresAt DateTime  @map("code_expires_at") // Data de expiração do código
  codeAttempts  Int       @default(0) @map("code_attempts") // Número de tentativas incorretas de validar o código
  verifiedAt    DateTime? @map("verified_at") // Data em que o código foi validado com sucesso

  resetTokenHash      String?   @map("reset_token_hash") // Hash do token gerado após a validação do código, usado para redefinir a senha
  resetTokenExpiresAt DateTime? @map("reset_token_expires_at") // Data de expiração do token de redefinição de senha
  usedAt              DateTime? @map("used_at") // Data em que o token de redefinição de senha foi usado

  invalidatedAt DateTime? @map("invalidated_at") // Data em que a solicitação de redefinição de senha foi invalidada (ex: usuário solicitou uma nova redefinição antes de usar a anterior)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId]) // Índice para facilitar buscas por usuário
  @@map("password_resets")
}
