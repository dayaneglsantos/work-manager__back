JWT_SECRET=chavesegredaparaautenticação
PASSWORD_RESET_SECRET=adicione_um_segredo_aleatorio_seguro
NODE_ENV=development

FRONTEND_DEV_URL=url_de_desenvolvimento
FRONTEND_PROD_URL=url_de_producao

DATABASE_URL=sua_string_de_conexão_aqui

DB_DATABASE=nome_do_banco_de_dados
DB_USERNAME=nome_do_usuario
DB_PASSWORD=senha_do_usuario

# ====== PORTAS ======
DB_PORT=Porta_do_banco_de_dados
APP_PORT=3000

# ====== E-MAIL ======
# No Docker Compose, o backend encontra o Mailpit pelo nome do serviço.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
EMAIL_FROM=Work Manager <no-reply@work-manager.local>

# Mailpit não exige autenticação. Estas variáveis ficam disponíveis para um
# provedor SMTP futuro e podem permanecer vazias no desenvolvimento local.
SMTP_USER=
SMTP_PASSWORD=

# ====== CLOUDINARY - Serviço de Armazenamento de Imagens e Arquivos ======
CLOUDINARY_CLOUD_NAME=nome_do_ambiente
CLOUDINARY_API_KEY=chave_publica
CLOUDINARY_API_SECRET=segredo
